# Which cloud 3D provider to use. Leave TRIPO_API_KEY empty to run in local (in-browser) mode only.
MODEL_PROVIDER=tripo
# Get a key at https://platform.tripo3d.ai (keys start with tsk_)
TRIPO_API_KEY=
# Backend port (Vite proxies /api to it)
PORT=8787
# Give up on a cloud job after this many ms
JOB_TIMEOUT_MS=180000
